  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1986845190}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7684a7be71ec4ca42a8995e99203673e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    name: mantis
    options:
    - '*Dap up the alien.*'
    - Hey there!
    - '*Let the mantis touch your face.*'
    - What do I do for fun? I like to watch Movies!
    - What's my favorite food?
    - You want to touch my face?
    - '*Start belting some lyrics about loving a mantis!*'
    - '*Politely wait for the mantis to finish.*

      That sounded lovely, you
      have a beautiful whistle.'
    - '*Start whistling alongside the mantis, harmonising together.*'
    - '*Pick up a broken stick from the ground and gift it to the Mantis.*'
    - '*Let the Mantis do what it wants to do without interuption.*'
    - '*Hold the Mantis'' arm and guide them to a tree.*'
    - '*Applaud the amazing display of skill.*'
    - Thank you, that is very kind of you.
    - '*Gently hug the Mantis.*'
    - I'm sorry, I don't think I can see a future with us.
    - I would love to date you, yes.
    - '*Draw a ''YES'' on the Mantis'' hand*'
    respones:
    - The Mantis looks scared and confused.
    - The Mantis clicks. It seemed polite.
    - The Mantis clicks and smiles.
    - The Mantis disapproves...
    - The Mantis starts sniffing, then stares blankly. Maybe you don't smell as nice.
    - The mantis clicks excitedly, as it gently brushes your face with its scythe-like
      arms.
    - The Mantis cowers and covers its ears... Maybe you didn't sound as good as
      you thought.
    - The Mantis clicks politely, and does a little bow.
    - The Mantis seems to be in bliss as it continues to appreciate the harmonised
      tune.
    - The Mantis grabs it, shrieks, and drops the stick. Having a closer look, the
      stick had a bunch of splinters in it. The mantis walks away, stopping at a
      tree.
    - The Mantis clicks in a similar way to a bat, or dolphin. It eventually makes
      it's way to a tree.
    - It seems satisfied with this.
    - The Mantis flinches every time the sudden clap sound is made.
    - The Mantis seems to appreciates the politeness.
    - The Mantis seems to whistle with happiness.
    - The Mantis looks sad, but nods politely.
    - The Mantis seems happy.
    - The Mantis gives you a hug, touches your face, and gently kisses you.
    actions:
    - '*The most beautiful forest you''ve ever seen. The birds chirping, mixed with
      the sounds of the wind in the trees sound angelic. You hear a clicking, and
      see a mantis-like creature hops towards you. It clicks inquisitively and reaches
      its hand out.*'
    - '*The mantis clicks and taps its staff and gestures to you.*'
    - '*The Mantis starts whistling a pretty tune.*'
    - '*The Mantis starts hopping around, impressively still using its staff for
      guidance, seemingly searching for something.*'
    - '*The Mantis uses its staff to become taller, and grab two pink fruits from
      a tree. It methodically climbs down, and reaches out its hand to you.*'
    - '*The Mantis draws a ''<3'' Into the ground, and then a ''?'', then holds out
      their hand.*'
    - '*The Mantis hops twice, giving a series of clicks before hopping away into
      the forest.*'
